{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yield-atlas",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "services": [
    {
      "binding": "QUOTE_SERVICE",
      "service": "yield-atlas"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DAILY_SCHEDULER", "class_name": "DailyDigestScheduler" }
    ]
  },
  "migrations": [
    { "tag": "v1-add-daily-digest-scheduler", "new_sqlite_classes": ["DailyDigestScheduler"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["45 8,9 * * MON-FRI", "0 9,10 * * MON-FRI"]
  }
}
