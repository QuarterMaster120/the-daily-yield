{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yield-atlas",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 9,10 * * MON-FRI"]
  }
}
